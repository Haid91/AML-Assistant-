PORT=3000
FRONTEND_URL=http://localhost:5173

# Supabase Postgres connection string — Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

ANTHROPIC_API_KEY=your_api_key_here

# Stripe — Dashboard > Developers > API keys / Products / Webhooks
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRICE_ID=price_your_premium_monthly_price_id
# Optional — only needed if annual Premium billing is enabled. A second Price
# on the same Premium product (not a separate product), since annual vs.
# monthly premium is the same offering billed differently. Without it,
# checkout requests for plan:'premium_annual' return a clean 503, not an error.
STRIPE_PRICE_ID_PREMIUM_ANNUAL=price_your_premium_annual_price_id
# Optional — only needed if the Professional tier is enabled. Without it,
# checkout requests for plan:'professional' return a clean 503, not an error.
STRIPE_PRICE_ID_PROFESSIONAL=price_your_professional_monthly_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Email — Resend (resend.com > API Keys)
RESEND_API_KEY=re_your_api_key_here
# Optional: overrides the sandbox sender once you've verified your own domain in Resend
RESEND_FROM=AmlIntel <onboarding@resend.dev>
# Inbox that receives contact-form submissions
EMAIL_FROM=
